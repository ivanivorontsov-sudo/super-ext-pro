{
 "manifest_version": 3,
 "name": "Super Ext Pro",
 "short_name": "Super Ext Pro",
 "version": "1.1.0",
 "description": "Super Ext Pro: загрузки медиа и HLS→MP4, скриншоты+OCR, блокировка рекламы, тёмная тема, режим чтения, менеджер вкладок, заметки, QR, пипетка, линейка, куки, свои CSS/JS. Переводчик видео: субтитры и закадровый голос. Без телеметрии.",
 "icons": {
  "16": "icons/i16.png",
  "32": "icons/i32.png",
  "48": "icons/i48.png",
  "128": "icons/i128.png"
 },
 "action": {
  "default_popup": "popup.html",
  "default_title": "Super Ext Pro"
 },
 "side_panel": {
  "default_path": "panel.html"
 },
 "options_page": "options.html",
 "background": {
  "service_worker": "background.js"
 },
 "permissions": [
  "activeTab",
  "tabs",
  "scripting",
  "downloads",
  "storage",
  "sidePanel",
  "webRequest",
  "contextMenus",
  "pageCapture",
  "declarativeNetRequestWithHostAccess",
  "unlimitedStorage",
  "cookies",
  "alarms",
  "tabGroups",
  "declarativeNetRequest",
  "declarativeNetRequestFeedback",
  "tabCapture",
  "offscreen",
  "tts"
 ],
 "host_permissions": [
  "<all_urls>"
 ],
 "content_scripts": [
  {
   "matches": [
    "<all_urls>"
   ],
   "js": [
    "pro-content.js"
   ],
   "run_at": "document_start"
  },
  {
   "matches": [
    "<all_urls>"
   ],
   "js": [
    "content.js"
   ],
   "run_at": "document_idle",
   "all_frames": false
  },
  {
   "matches": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
   ],
   "js": [
    "youtube.js"
   ],
   "css": [
    "youtube.css"
   ],
   "run_at": "document_idle"
  },
  {
   "matches": [
    "<all_urls>"
   ],
   "js": [
    "vt/common.js",
    "vt/content.js"
   ],
   "run_at": "document_idle"
  }
 ],
 "content_security_policy": {
  "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
 },
 "declarative_net_request": {
  "rule_resources": [
   {
    "id": "ads",
    "enabled": true,
    "path": "rules/ads.json"
   }
  ]
 },
 "commands": {
  "_execute_action": {
   "suggested_key": {
    "default": "Alt+Shift+S"
   }
  }
 }
}